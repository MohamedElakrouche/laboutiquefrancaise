{% extends 'base.html.twig' %} {% block body %}
<h1 class="text-center text-2xl font-bold mb-4">
  Ma catégorie {{ category.name }}
</h1>

<p class="text-center text-gray-700 mb-6">
  Cette catégorie contient {{ category.products | length }} produits
</p>

<div
  class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
>
  {% for product in category.products %}
  <div class="bg-white border rounded-lg shadow hover:shadow-lg transition p-4">
    <h2 class="text-center text-lg font-semibold text-gray-800 mb-2">
      {{ product.name }}
    </h2>
    <img
      src="/uploads/{{ product.illustration }}"
      alt="{{ product.name }}"
      class="w-full h-40 object-cover rounded mb-4"
    />
    <p class="text-gray-600 text-sm">Description du produit ici...</p>
    <p>{{ product.pricewt }} $</p>
  </div>
  {% endfor %}
</div>
{% endblock %}
